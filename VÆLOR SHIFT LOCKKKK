local Janitor = { Connections = {}, Instances = {}, RenderSteps = {}, Actions = {} }
function Janitor:AddConnection(conn) table.insert(self.Connections, conn) return conn end
function Janitor:AddInstance(ins) table.insert(self.Instances, ins) return ins end
function Janitor:AddRenderStep(name) table.insert(self.RenderSteps, name) return name end
function Janitor:AddAction(name) table.insert(self.Actions, name) return name end

function Janitor.Destroy()
    for _, conn in ipairs(Janitor.Connections) do if conn and conn.Connected then conn:Disconnect() end end
    for _, ins in ipairs(Janitor.Instances) do if ins and ins.Parent then ins:Destroy() end end
    local RunService = game:GetService("RunService")
    for _, name in ipairs(Janitor.RenderSteps) do pcall(function() RunService:UnbindFromRenderStep(name) end) end
    for _, name in ipairs(Janitor.Actions) do pcall(function() game:GetService("ContextActionService"):UnbindAction(name) end) end
    local UserInputService = game:GetService("UserInputService")
    local UserGameSettings = UserSettings():GetService("UserGameSettings")
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    pcall(function() UserGameSettings.RotationType = Enum.RotationType.MovementRelative end)
    pcall(function() game:GetService("Players").LocalPlayer:GetMouse().Icon = "" end)
end
globalEnv[SCRIPT_ID] = Janitor

